{
  "name": "harbour",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "harbour": "./bin/harbour.mjs"
  },
  "scripts": {
    "dev": "node bin/harbour.mjs dev",
    "build": "next build",
    "start": "node bin/harbour.mjs start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "harbour": "node bin/harbour.mjs",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.95.2",
    "better-sqlite3": "^12.8.0",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
