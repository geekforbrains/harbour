// Harbour v2 database schema for ERD rendering.
// Source of truth: src/lib/db/schema.ts (initializeSchema).

Project harbour {
  database_type: 'SQLite'
  Note: 'Harbour v2 control plane schema. IDs are uuid TEXT except run_output.id.'
}

// Identity + access

Table users {
  id TEXT [pk]
  email TEXT [not null, unique]
  password_hash TEXT
  display_name TEXT [not null]
  is_instance_admin INTEGER [not null, default: 0]
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]
}

Table orgs {
  id TEXT [pk]
  name TEXT [not null]
  slug TEXT [not null, note: 'Creation-time immutable workspace path segment. Unique by idx_orgs_slug.']
  settings TEXT [not null, default: '{}']
  archived_at INTEGER
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    slug [unique, name: 'idx_orgs_slug']
  }
}

Table memberships {
  user_id TEXT [not null]
  org_id TEXT [not null]
  role TEXT [not null, check: `role IN ('editor','viewer')`]
  created_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    (user_id, org_id) [pk]
    org_id [name: 'idx_memberships_org']
  }
}

Table sessions {
  id TEXT [pk]
  user_id TEXT [not null]
  expires_at INTEGER [not null]
  created_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    user_id [name: 'idx_sessions_user']
  }
}

Table set_password_tokens {
  id TEXT [pk]
  token_hash TEXT [not null, unique]
  user_id TEXT [not null]
  created_by_user_id TEXT
  expires_at INTEGER [not null]
  consumed_at INTEGER
  created_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    token_hash [name: 'idx_set_password_tokens_hash']
  }
}

Table admin_api_keys {
  id TEXT [pk]
  name TEXT [not null]
  api_key_hash TEXT [not null, unique]
  created_by_user_id TEXT [not null]
  last_used_at INTEGER
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]
}

Table runners {
  id TEXT [pk]
  name TEXT [not null]
  token_hash TEXT [not null, unique]
  tier TEXT [not null, check: `tier IN ('local','remote')`]
  labels TEXT [not null, default: '[]']
  capabilities TEXT
  scope TEXT
  last_polled_at INTEGER
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    token_hash [unique, name: 'idx_runners_token']
  }
}

// Hierarchy

Table projects {
  id TEXT [pk]
  org_id TEXT [not null]
  name TEXT [not null]
  slug TEXT [not null, note: 'Creation-time immutable workspace path segment. Unique per org.']
  archived_at INTEGER
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    org_id [name: 'idx_projects_org']
    (org_id, slug) [unique, name: 'idx_projects_org_slug']
  }
}

Table agents {
  id TEXT [pk]
  project_id TEXT [not null]
  name TEXT [not null]
  slug TEXT [not null, note: 'Creation-time immutable workspace path segment. Unique per project.']
  description TEXT
  cli TEXT
  model TEXT
  thinking TEXT
  color TEXT
  eager INTEGER [not null, default: 0]
  placement TEXT [not null, default: 'local']
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    project_id [name: 'idx_agents_project']
    (project_id, slug) [unique, name: 'idx_agents_project_slug']
  }
}

// Operational entities

Table jobs {
  id TEXT [pk]
  org_id TEXT [not null]
  project_id TEXT [note: 'NULL means org-level workflow job. Agent jobs require a project_id.']
  kind TEXT [not null, default: 'agent', check: `kind IN ('agent','workflow')`]
  agent_id TEXT [note: 'Set for agent jobs; NULL for workflow jobs.']
  name TEXT [not null]
  description TEXT
  instructions TEXT
  schedule TEXT [not null]
  prerun_runtime TEXT [check: `prerun_runtime IS NULL OR prerun_runtime IN ('bash','python','node')`]
  prerun_script TEXT
  postrun_runtime TEXT [check: `postrun_runtime IS NULL OR postrun_runtime IN ('bash','python','node')`]
  postrun_script TEXT
  postrun_gates INTEGER [not null, default: 0]
  workflow_runtime TEXT [check: `workflow_runtime IS NULL OR workflow_runtime IN ('bash','python','node')`]
  workflow_script TEXT
  placement TEXT [not null, default: 'local']
  timeout_minutes INTEGER [not null, default: 30]
  model TEXT
  thinking TEXT
  title_format TEXT
  active INTEGER [not null, default: 1]
  last_run_at INTEGER
  next_run_at INTEGER
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    org_id [name: 'idx_jobs_org']
    project_id [name: 'idx_jobs_project']
    agent_id [name: 'idx_jobs_agent']
    (kind, agent_id, active, next_run_at) [name: 'idx_jobs_schedule']
  }

  checks {
    `kind != 'agent' OR project_id IS NOT NULL`
  }
}

Table runs {
  id TEXT [pk]
  org_id TEXT [not null]
  project_id TEXT [note: 'Denormalized from jobs.project_id; NULL for org-level workflow runs.']
  job_id TEXT [not null]
  agent_id TEXT [note: 'NULL for workflow runs or after agent delete.']
  status TEXT [not null, default: 'running', check: `status IN ('scheduled','running','waiting','pending','done','failed','skipped','killed')`]
  title TEXT
  placement TEXT [not null, default: 'local']
  claimed_by TEXT
  exec_token_hash TEXT
  scheduled_for INTEGER
  claimed_at INTEGER
  completed_at INTEGER
  kill_requested_at INTEGER
  extra_instructions TEXT
  session_id TEXT
  session_cwd TEXT
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    org_id [name: 'idx_runs_org']
    project_id [name: 'idx_runs_project']
    job_id [name: 'idx_runs_job']
    agent_id [name: 'idx_runs_agent']
    status [name: 'idx_runs_status']
    claimed_by [name: 'idx_runs_claimed_by']
  }
}

Table run_activity {
  id TEXT [pk]
  run_id TEXT [not null]
  author_type TEXT [not null, check: `author_type IN ('agent','user','system','workflow')`]
  author_id TEXT
  author_name TEXT
  content TEXT
  created_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    run_id [name: 'idx_run_activity_run']
    (run_id, created_at) [name: 'idx_run_activity_run_time']
  }
}

Table run_output {
  id INTEGER [pk, increment]
  run_id TEXT [not null]
  event_type TEXT [not null]
  content TEXT
  tool_name TEXT
  created_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    run_id [name: 'idx_run_output_run']
  }
}

Table run_attachments {
  id TEXT [pk]
  run_id TEXT [not null]
  activity_id TEXT
  kind TEXT [not null, check: `kind IN ('file','embed')`]
  filename TEXT
  storage_path TEXT
  mime_type TEXT
  size_bytes INTEGER
  url TEXT
  embed_provider TEXT
  title TEXT
  uploaded_by_type TEXT [check: `uploaded_by_type IN ('user','agent')`]
  uploaded_by_id TEXT
  uploaded_by_name TEXT
  created_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    run_id [name: 'idx_run_attachments_run']
    activity_id [name: 'idx_run_attachments_activity']
  }
}

Table attachment_processing {
  id TEXT [pk]
  attachment_id TEXT [not null, unique]
  run_id TEXT [not null, note: 'Denormalized lookup column; no FK in source DDL.']
  status TEXT [not null, check: `status IN ('queued','processing','done','failed')`]
  transcript_path TEXT
  screenshots_dir TEXT
  screenshot_count INTEGER [not null, default: 0]
  screenshot_interval INTEGER
  duration_seconds REAL
  error TEXT
  started_at INTEGER
  completed_at INTEGER
  created_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    attachment_id [name: 'idx_attachment_processing_attachment']
    run_id [name: 'idx_attachment_processing_run']
  }
}

// Resources

Table docs {
  id TEXT [pk]
  org_id TEXT [not null]
  project_id TEXT [note: 'NULL means org-level shared resource.']
  title TEXT [not null]
  pinned INTEGER [not null, default: 0]
  created_by_type TEXT [check: `created_by_type IN ('user','agent')`]
  created_by_id TEXT
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    (org_id, project_id) [name: 'idx_docs_org_project']
  }
}

Table doc_revisions {
  id TEXT [pk]
  doc_id TEXT [not null]
  content TEXT [not null]
  author_type TEXT [check: `author_type IN ('user','agent')`]
  author_id TEXT
  created_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    doc_id [name: 'idx_doc_revisions_doc']
  }
}

Table env_vars {
  id TEXT [pk]
  org_id TEXT [not null]
  project_id TEXT [note: 'NULL means org-level shared secret.']
  name TEXT [not null]
  encrypted_value TEXT [not null]
  pinned INTEGER [not null, default: 0]
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    (org_id, project_id) [name: 'idx_env_vars_org_project']
  }
}

Table tables {
  id TEXT [pk]
  org_id TEXT [not null]
  project_id TEXT [note: 'NULL means org-level shared table.']
  name TEXT [not null]
  table_name TEXT [not null, unique]
  pinned INTEGER [not null, default: 0]
  created_at INTEGER [not null, default: `unixepoch()`]
  updated_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    (org_id, project_id) [name: 'idx_tables_org_project']
  }
}

Table table_migrations {
  id TEXT [pk]
  table_id TEXT [not null]
  version INTEGER [not null]
  description TEXT
  sql TEXT [not null]
  created_at INTEGER [not null, default: `unixepoch()`]

  indexes {
    table_id [name: 'idx_table_migrations_tbl']
  }
}

// Job-linked resources

Table job_docs {
  job_id TEXT [not null]
  doc_id TEXT [not null]

  indexes {
    (job_id, doc_id) [pk]
  }
}

Table job_env_vars {
  job_id TEXT [not null]
  env_var_id TEXT [not null]

  indexes {
    (job_id, env_var_id) [pk]
  }
}

Table job_tables {
  job_id TEXT [not null]
  table_id TEXT [not null]

  indexes {
    (job_id, table_id) [pk]
  }
}

// Instance settings

Table settings {
  key TEXT [pk]
  value TEXT [not null]
}

// Foreign keys

Ref: memberships.user_id > users.id [delete: cascade]
Ref: memberships.org_id > orgs.id [delete: cascade]
Ref: sessions.user_id > users.id [delete: cascade]
Ref: set_password_tokens.user_id > users.id [delete: cascade]
Ref: set_password_tokens.created_by_user_id > users.id [delete: set null]
Ref: admin_api_keys.created_by_user_id > users.id [delete: cascade]

Ref: projects.org_id > orgs.id [delete: cascade]
Ref: agents.project_id > projects.id [delete: cascade]

Ref: jobs.org_id > orgs.id [delete: cascade]
Ref: jobs.project_id > projects.id [delete: cascade]
Ref: jobs.agent_id > agents.id [delete: cascade]

Ref: runs.org_id > orgs.id [delete: cascade]
Ref: runs.project_id > projects.id [delete: cascade]
Ref: runs.job_id > jobs.id [delete: cascade]
Ref: runs.agent_id > agents.id [delete: set null]
Ref: runs.claimed_by > runners.id [delete: set null]

Ref: run_activity.run_id > runs.id [delete: cascade]
Ref: run_output.run_id > runs.id [delete: cascade]
Ref: run_attachments.run_id > runs.id [delete: cascade]
Ref: run_attachments.activity_id > run_activity.id [delete: set null]
Ref: attachment_processing.attachment_id > run_attachments.id [delete: cascade]

Ref: docs.org_id > orgs.id [delete: cascade]
Ref: docs.project_id > projects.id [delete: cascade]
Ref: doc_revisions.doc_id > docs.id [delete: cascade]
Ref: env_vars.org_id > orgs.id [delete: cascade]
Ref: env_vars.project_id > projects.id [delete: cascade]
Ref: tables.org_id > orgs.id [delete: cascade]
Ref: tables.project_id > projects.id [delete: cascade]
Ref: table_migrations.table_id > tables.id [delete: cascade]

Ref: job_docs.job_id > jobs.id [delete: cascade]
Ref: job_docs.doc_id > docs.id [delete: cascade]
Ref: job_env_vars.job_id > jobs.id [delete: cascade]
Ref: job_env_vars.env_var_id > env_vars.id [delete: cascade]
Ref: job_tables.job_id > jobs.id [delete: cascade]
Ref: job_tables.table_id > tables.id [delete: cascade]
